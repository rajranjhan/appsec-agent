# Export these in your shell or inject them through a secret manager.
# The application deliberately does not auto-load dotenv files from scanned projects.
APPSEC_PROVIDER=openai
APPSEC_MODEL=your-tool-capable-model-id
APPSEC_API_KEY=replace-with-your-provider-key
# OpenAI-compatible gateway (HTTPS only):
# APPSEC_BASE_URL=https://llm.example.com/v1
# APPSEC_ALLOWED_HOSTS=["llm.example.com"]
# For Anthropic: APPSEC_PROVIDER=anthropic and use an Anthropic model ID/API key.
